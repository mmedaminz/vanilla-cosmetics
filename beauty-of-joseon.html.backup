<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Beauty of Joseon Sunscreen | Vanilla Cosmetics</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f7f3ea;
    color:#3f4935;
}

.hero-product{
    background:#556B2F;
    color:#fff;
    text-align:center;
    padding:28px 20px 55px;
    border-radius:0 0 35px 35px;
    box-shadow:0 8px 25px rgba(0,0,0,.12);
}

.brand{
    font-size:14px;
    letter-spacing:2px;
    margin-bottom:25px;
}

.product-image{
    width:100%;
    max-width:380px;
    height:auto;
    display:block;
    margin:0 auto 28px;
    border-radius:28px;
    box-shadow:0 12px 30px rgba(0,0,0,.18);
}

h1{
    font-size:38px;
    margin:10px 0;
    letter-spacing:.5px;
}

.subtitle{
    font-size:17px;
    line-height:1.9;
    max-width:600px;
    margin:15px auto;
}

.price{
    font-size:32px;
    font-weight:bold;
    margin:24px 0;
    letter-spacing:1px;
}

.order-btn{
    display:inline-block;
    background:#f5f0e6;
    color:#556B2F;
    text-decoration:none;
    padding:17px 45px;
    border-radius:40px;
    font-size:18px;
    font-weight:bold;
    box-shadow:0 7px 18px rgba(0,0,0,.15);
}

.section{
    max-width:800px;
    margin:auto;
    padding:55px 20px;
    text-align:center;
}

.section h2{
    font-family:Georgia,serif;
    font-size:28px;
    margin-bottom:18px;
}

.description{
    line-height:2;
    font-size:16px;
}

.benefits{
    display:grid;
    gap:12px;
    margin-top:25px;
}

.benefit{
    background:#fff;
    padding:18px;
    border-radius:18px;
    box-shadow:0 5px 18px rgba(0,0,0,.06);
    border:1px solid rgba(85,107,47,.08);
}
.order-box{
    background:#556B2F;
    color:#fff;
    border-radius:28px;
    padding:35px 22px;
    box-shadow:0 10px 28px rgba(0,0,0,.12);
}

.order-box input,
.order-box select,
.order-box textarea{
    width:100%;
    padding:14px;
    margin:7px 0;
    border:0;
    border-radius:12px;
    font-size:15px;
}

.submit-btn{
    width:100%;
    margin-top:12px;
    padding:17px;
    border:0;
    border-radius:35px;
    background:#f7f3ea;
    box-shadow:0 6px 16px rgba(0,0,0,.12);
    color:#556B2F;
    font-size:17px;
    font-weight:bold;
}

.info{
    margin-top:20px;
    line-height:2;
    font-size:14px;
}

.footer{
    background:#556B2F;
    color:#f5f0e6;
    text-align:center;
    padding:22px 15px;
    font-size:12px;
}

.footer a{
    color:#f5f0e6;
    text-decoration:none;
}

@media(max-width:600px){
    h1{
        font-size:29px;
    }

    .product-image{
        max-width:320px;
    }
}
</style>
</head>

<body>

<section class="hero-product">

    <div class="brand">
        VANILLA COSMETICS
    </div>

    <p style="font-size:13px;letter-spacing:1px;margin-bottom:10px;">
        عناية خاصة لبشرة أكثر إشراقًا
    </p>

    <img
        class="product-image"
        src="images/Koria.jpg"
        alt="Beauty of Joseon Sunscreen"
    >

    <h1>Beauty of Joseon Sunscreen</h1>

    <p class="subtitle">
        واقي شمس كوري بتركيبة خفيفة ومريحة، يوفر حماية عالية SPF50+ PA++++
        من الأشعة فوق البنفسجية، ويساعد على ترطيب البشرة ومنحها مظهرًا ناعمًا ومشرقًا.
    </p>

    <div class="price">
        3800 DA
    </div>

    <a class="order-btn" href="#order">
        اطلبي الآن ✦
    </a>

</section>

<section class="section">

    <h2>
        Beauty of Joseon Sunscreen
    </h2>

    <p class="description">
        واقي شمس كوري مميز مصمم للاستخدام اليومي، بتركيبة
        خفيفة ومريحة تساعد على حماية البشرة من الأشعة فوق البنفسجية
        مع منحها ترطيبًا وإحساسًا ناعمًا ومظهرًا أكثر إشراقًا.
        بفضل حماية SPF50+ PA++++، يناسب روتين العناية اليومي
        ويمنح البشرة حماية عالية دون إحساس ثقيل.
    </p>

    <div class="benefits">

        <div class="benefit">
            ✦ حماية عالية SPF50+ PA++++ من الأشعة فوق البنفسجية
        </div>

        <div class="benefit">
            ✦ تركيبة خفيفة ومريحة للاستخدام اليومي
        </div>

        <div class="benefit">
            ✦ يساعد على ترطيب البشرة والحفاظ على نعومتها
        </div>

        <div class="benefit">
            ✦ يمنح البشرة مظهرًا ناعمًا ومشرقًا
        </div>

        <div class="benefit">
            ✦ مثالي للإضافة إلى روتين العناية اليومي
        </div>

    </div>

</section>
<section class="section" id="order">

    <div class="order-box">

        <div style="font-size:12px;letter-spacing:2px;margin-bottom:8px;">ORDER NOW</div>

        <h2>
            اطلبي Beauty of Joseon Sunscreen الآن
        </h2>

        <p>
            🚚 التوصيل إلى 69 ولاية
            <br>
            💳 الدفع عند الاستلام
        </p>

        <div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:20px 0;">
    <span style="background:rgba(255,255,255,.12);padding:9px 14px;border-radius:20px;font-size:13px;">
        🚚 توصيل 69 ولاية
    </span>
    <span style="background:rgba(255,255,255,.12);padding:9px 14px;border-radius:20px;font-size:13px;">
        💳 الدفع عند الاستلام
    </span>
</div>

<form id="orderForm">

            <input
                type="text"
                id="name"
                placeholder="الاسم الكامل"
                autocomplete="name"
                required
            >

            <input
                type="tel"
                id="phone"
                placeholder="رقم الهاتف"
                inputmode="tel"
                autocomplete="tel"
                required
            >

            <input
                type="text"
                id="wilaya"
                placeholder="الولاية"
                required
            >

            <input
                type="text"
                id="commune"
                placeholder="البلدية"
                required
            >

            <textarea
                id="address"
                placeholder="العنوان"
                rows="3"
                required
            ></textarea>

            <button class="submit-btn" type="submit">
                تأكيد الطلب عبر WhatsApp
            </button>

        </form>

        <div class="info">
            سيتم تحويلك مباشرة إلى WhatsApp لإرسال طلبك.
        </div>

    </div>

</section>

<footer class="footer">

    <div>
        © 2026 Vanilla Cosmetics — جميع الحقوق محفوظة.
    </div>

    <div>
        Developed by
        <a href="#" target="_blank">
            mohamed amine ziadi
        </a>
    </div>

</footer>

<script>
document.getElementById("orderForm").addEventListener("submit", function(e){

    e.preventDefault();

    const name = document.getElementById("name").value;
    const phone = document.getElementById("phone").value;
    const wilaya = document.getElementById("wilaya").value;
    const commune = document.getElementById("commune").value;
    const address = document.getElementById("address").value;

    const message =
`طلب Beauty of Joseon Sunscreen

الاسم: ${name}
الهاتف: ${phone}
الولاية: ${wilaya}
البلدية: ${commune}
العنوان: ${address}

المنتج: Beauty of Joseon Sunscreen
السعر: 3800 DA`;

    const whatsapp =
        "https://wa.me/213798949861?text=" +
        encodeURIComponent(message);

    window.open(whatsapp, "_blank");
});
</script>

</body>
</html>
