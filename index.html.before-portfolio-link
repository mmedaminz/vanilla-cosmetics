<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vanilla Cosmetics</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#faf8f2;
    color:#30332c;
    font-family:Arial,Tahoma,sans-serif;
}

button,
input,
textarea,
select{
    font-family:inherit;
}

button{
    cursor:pointer;
}

a{
    text-decoration:none;
    color:inherit;
}

/* HEADER */

.header{
    position:fixed;
    top:0;
    right:0;
    left:0;
    height:70px;
    background:rgba(250,248,242,.96);
    border-bottom:1px solid #e4dfd3;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 18px;
    z-index:1000;
}

.logo{
    text-align:center;
}

.logo span{
    display:block;
    font-family:Georgia,serif;
    font-size:27px;
    color:#3f4935;
}

.logo small{
    display:block;
    margin-top:3px;
    font-size:9px;
    letter-spacing:3px;
    color:#788267;
}

/* ICON BUTTONS */

.icon-button{
    width:44px;
    height:44px;
    border:0;
    border-radius:50%;
    background:#f5f0e6;
    color:#3f4935;
    font-size:20px;
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
}

.cart-count{
    position:absolute;
    top:-3px;
    right:-3px;
    width:20px;
    height:20px;
    border-radius:50%;
    background:#556B2F;
    color:#fff;
    font-size:11px;
    display:flex;
    align-items:center;
    justify-content:center;
}

/* OVERLAY */

.overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.4);
    opacity:0;
    visibility:hidden;
    transition:.3s;
    z-index:1500;
}

.overlay.active{
    opacity:1;
    visibility:visible;
}

/* SIDE MENU */

.side-menu{
    position:fixed;
    top:0;
    right:-320px;
    width:300px;
    height:100vh;
    background:#3f4935;
    color:#fff;
    padding:85px 25px 30px;
    z-index:2000;
    transition:.35s;
    border-radius:0 0 0 25px;
}

.side-menu.active{
    right:0;
}

.close-menu{
    position:absolute;
    top:18px;
    left:18px;
    width:42px;
    height:42px;
    border:1px solid rgba(255,255,255,.3);
    border-radius:50%;
    background:transparent;
    color:#fff;
    font-size:25px;
}

.side-logo{
    font-family:Georgia,serif;
    font-size:27px;
    margin-bottom:35px;
}

.side-menu a{
    display:block;
    padding:17px 0;
    border-bottom:1px solid rgba(255,255,255,.15);
    font-size:14px;
}

/* HERO */

.hero{
    min-height:100vh;
    padding:120px 20px 70px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:
    radial-gradient(circle at 20% 20%,rgba(89,99,74,.12),transparent 35%),
    radial-gradient(circle at 80% 80%,rgba(214,205,184,.4),transparent 35%),
    #faf8f2;
}

.hero-content{
    max-width:650px;
}

.eyebrow{
    font-size:10px;
    letter-spacing:4px;
    color:#788267;
    margin-bottom:20px;
}

.hero h1{
    font-family:Georgia,serif;
    font-size:clamp(60px,15vw,105px);
    line-height:.85;
    color:#3f4935;
}

.hero h1 span{
    font-style:italic;
    font-size:.55em;
    color:#788267;
}

.hero-text{
    max-width:500px;
    margin:35px auto;
    color:#77796f;
    line-height:2;
    font-size:14px;
}

.main-btn{
    display:inline-block;
    padding:15px 30px;
    border-radius:30px;
    background:#3f4935;
    color:#fff;
    transition:.3s;
}

.main-btn:hover{
    transform:translateY(-3px);
}

/* MOBILE */

@media(max-width:600px){

    .header{
        padding:0 14px;
    }

    .logo span{
        font-size:23px;
    }

    .hero h1{
        font-size:68px;
    }

    .side-menu{
        width:290px;
    }
} 
/* PRODUCTS */

.products-section{
    padding:90px 18px;
    background:#faf8f2;
}

.section-heading{
    max-width:650px;
    margin:0 auto 45px;
    text-align:center;
}

.section-heading span{
    font-size:10px;
    letter-spacing:4px;
    color:#788267;
}

.section-heading h2{
    font-family:Georgia,serif;
    font-size:42px;
    color:#3f4935;
    margin:10px 0;
}

.section-heading p{
    color:#77796f;
    font-size:14px;
}

.products-container{
    max-width:600px;
    margin:auto;
    display:flex;
    flex-direction:column;
    gap:25px;
}

.product-card{
    background:#fff;
    border:1px solid #e4dfd3;
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 8px 25px rgba(50,50,40,.05);
}

.product-image{
    width:100%;
    aspect-ratio:1/1;
    background:#f5f0e6;
    overflow:hidden;
}

.product-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

.product-info{
    padding:22px;
}

.product-category{
    font-size:9px;
    letter-spacing:2px;
    color:#788267;
}

.product-info h3{
    font-size:20px;
    margin:8px 0;
    color:#30332c;
}

.product-info p{
    color:#77796f;
    font-size:13px;
    line-height:1.9;
    margin-bottom:18px;
}

.product-bottom{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
}

.product-price{
    color:#3f4935;
    font-size:20px;
    font-weight:bold;
    white-space:nowrap;
}

.product-price small{
    font-size:11px;
}

.add-cart{
    border:0;
    background:#3f4935;
    color:#fff;
    border-radius:25px;
    padding:11px 16px;
    font-size:12px;
    transition:.25s;
}

.add-cart:hover{
    background:#59634a;
    transform:translateY(-2px);
}

/* ORDER */

.order-section{
    padding:90px 18px;
    background:#f5f0e6;
}

.order-box{
    max-width:600px;
    margin:auto;
    background:#fff;
    padding:28px;
    border-radius:25px;
    border:1px solid #e4dfd3;
}

.form-group{
    margin-bottom:17px;
}

.form-group label{
    display:block;
    font-size:13px;
    font-weight:bold;
    margin-bottom:7px;
}

input,
textarea,
select{
    width:100%;
    border:1px solid #e4dfd3;
    background:#faf8f2;
    border-radius:12px;
    padding:14px;
    outline:none;
    color:#30332c;
    font-size:14px;
}

input:focus,
textarea:focus,
select:focus{
    border-color:#59634a;
}

select{
    appearance:none;
    -webkit-appearance:none;
    height:48px;
    background:#faf8f2;
    color:#30332c;
    padding:14px;
    border:1px solid #e4dfd3;
    border-radius:12px;
    outline:none;
    font-size:14px;
    font-family:inherit;
    cursor:pointer;
}

textarea{
    height:95px;
    resize:vertical;
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.order-summary{
    margin:23px 0;
    padding:18px;
    border-radius:15px;
    background:#faf8f2;
}

.summary-row{
    display:flex;
    justify-content:space-between;
    margin-bottom:9px;
    color:#77796f;
}

.summary-total{
    border-top:1px solid #e4dfd3;
    padding-top:12px;
    margin-bottom:0;
    color:#30332c;
    font-size:17px;
}

.confirm-order{
    width:100%;
    border:0;
    padding:16px;
    border-radius:30px;
    background:#3f4935;
    color:#fff;
    font-size:14px;
    transition:.3s;
}

.confirm-order:hover{
    background:#59634a;
}

/* CONTACT */

.contact-section{
    padding:90px 20px;
    text-align:center;
    background:#3f4935;
    color:#fff;
}

.contact-section > span{
